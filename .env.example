# ---------------------------------------------------------------------------
# Saee Life Herbal — environment overrides
# Copy to .env and edit. Real environment variables always take precedence.
# NEVER commit the production .env file.
# ---------------------------------------------------------------------------

# Application
SAEE_ENV=production
SAEE_DEBUG=0
APP_URL=https://example.com

# Database (omit to use the local SQLite file in storage/db/app.sqlite)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saee_life_herbal
DB_USERNAME=saee
DB_PASSWORD=

# 32-byte encryption key for KYC / bank data (openssl rand -hex 32)
SAEE_ENCRYPTION_KEY=

# Force HTTPS cookies (1 in production, 0 on plain-HTTP localhost)
SESSION_SECURE=0
