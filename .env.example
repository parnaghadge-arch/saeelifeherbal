# ---------------------------------------------------------------------------
# Saee Life Herbal — environment overrides
# Copy to .env and edit. Real environment variables always take precedence.
# NEVER commit the production .env file.
# ---------------------------------------------------------------------------

# Application
SAEE_ENV=production
# Set to 1 while setting up to see real error messages (turn off in production)
SAEE_DEBUG=0
# Leave blank to auto-detect; set the real domain in production, e.g. https://saeelifeherbal.com
APP_URL=

# Database
# XAMPP/WAMP defaults: host 127.0.0.1, user root, empty password.
# Leave DB_DRIVER out entirely to use the bundled SQLite file (storage/db/app.sqlite).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saeelifeherbal
DB_USERNAME=root
DB_PASSWORD=
# Connection collation. Must match the tables (this schema uses utf8mb4_unicode_ci).
# Leave as-is unless your host's tables were created with a different collation.
DB_COLLATION=utf8mb4_unicode_ci
# Shared hosting only: unix socket path, e.g. /var/lib/mysql/mysql.sock
# Use this if you see "SQLSTATE[HY000] [2002] Operation not permitted".
# DB_SOCKET=/var/lib/mysql/mysql.sock
# Connection retries and per-attempt timeout (seconds).
# DB_ATTEMPTS=3
# DB_TIMEOUT=5

# 32-byte encryption key for KYC / bank data (openssl rand -hex 32)
SAEE_ENCRYPTION_KEY=

# Force HTTPS cookies (1 in production, 0 on plain-HTTP localhost)
SESSION_SECURE=0

# Bypass the early database check once, e.g. to open the site before installing
# SAEE_SKIP_DB_CHECK=1

# Log every SQL statement (development only)
# SAEE_LOG_QUERIES=1
