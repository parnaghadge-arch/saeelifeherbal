# ---------------------------------------------------------------------------
# Saee Life Herbal — Apache configuration (production)
# ---------------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /

    # Block direct access to application internals
    RewriteRule ^(storage|vendor-src|database|tools|tests|docs)/ - [F,L]
    RewriteRule ^(config|lib|includes)/ - [F,L]

    # Real files and directories are served as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Member portal pretty URLs: /member/login -> /member/login.php
    RewriteRule ^member/wallets/?$ member/wallet.php [L,QSA]
    RewriteCond %{DOCUMENT_ROOT}/member/$1.php -f
    RewriteRule ^member/([a-z0-9-]+)/?$ member/$1.php [L,QSA]

    # SEO URLs -> router
    RewriteRule ^ index.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Correct MIME types for the bundled assets. Without these a server whose mime.types is
# incomplete can serve CSS/JS as text/html, and browsers refuse stylesheets and scripts
# ("Refused to apply style ... MIME type ('text/html')").
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType application/font-woff .woff
    AddType image/webp .webp
    AddType image/avif .avif
    AddType video/mp4 .mp4
    AddType application/pdf .pdf
</IfModule>

# Never cache private areas
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Upload size (must also be raised in php.ini: upload_max_filesize / post_max_size)
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 16M
</IfModule>

# Never serve secrets, dumps or logs.
<FilesMatch "\.(env|sqlite|sqlite3|db|sql|log|md|lock|ini|bak|dist|example)$">
    Require all denied
</FilesMatch>

# composer.json / package.json style files are safe to block, but the PWA manifest must load.
<FilesMatch "^(composer|package|package-lock)\.json$">
    Require all denied
</FilesMatch>

<Files "manifest.json">
    Require all granted
</Files>
